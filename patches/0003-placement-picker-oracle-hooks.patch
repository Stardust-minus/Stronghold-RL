+        return pp ? { leaks: (pp.leaked || []).filter((l) => l && l.counted !== false).length, boss: Math.max(0, Number(pp.bossDamage) || 0), kills: pp.killed || 0,
+          lg: { ...(pp.layerGains || {}) } } : null;
+      } catch { return null; }
+    });
+  } finally { m._oracle = hadOracle; }
+}
+
+/** Candidate picker: apply candidate `plan` for `chosen` (applyPlanSteps as one call). */
+export function applyPlanForPicker(m, ps, chosen, plan) { runSteps(applyPlanSteps(m, ps, chosen, plan)); }
+
+/**
+ * Training / diagnostics only (tools/rl track 2, equipment ceiling): legacy's equipItems, except that each EQUIP item's
+ * carrier is picked among K candidates — legacy's own target first, then the other owned operators with a free slot
+ * ranked by legacy's pieceValue (generation: no simulation) — by one rehearsal each of the current board with the item
+ * on that carrier (seed 'fixed' / 'live', as pickCandidatesForTraining). Rounds: `rounds` 'normal' | 'boss' | 'all'
+ * (a round outside them, or without a fight, keeps legacy's target). stats: { decisions, changed, cands, ms, byRound }.
+ */
+export function equipItemsPicked(m, ps, { K = 6, seed = 'fixed', rounds = 'all', stats = null } = {}) {
+  const gd = ps?.gd || m.gd;
+  const tried = new Set();
+  for (let guard = 0; guard < 12; guard++) {
+    const item = [...ps.hand, ...ps.temp].find((p) => p && p.kind === 'item' && canUseItem(m, ps, p) && !tried.has(p.uid));
+    if (!item) break;
+    tried.add(item.uid);
+    if (planContains(m, advisorPlan(m, ps)?.items?.keep, item.id)) continue;
+    const ctx = context(m, ps);
+    const rec = gd.item(item.id);
+    if (rec && rec.itemType === 'MAGIC') { useArt(m, ps, item, ctx); continue; }
+    let target = itemTarget(m, ps, item, ctx);
+    if (!target) continue;
+    const boss = !m.wave && bossWaveOf(m, ps), fight = !!m.wave || !!boss;
+    if (K > 1 && fight && (rounds === 'all' || (rounds === 'boss') === !!boss)) {
+      const t0 = performance.now();
+      const val = new Map(); const v = (p) => { if (!val.has(p.uid)) val.set(p.uid, pieceValue(m, ps, p, ctx)); return val.get(p.uid); };
+      const onBoard = (p) => ps.find(p.uid)?.area === 'board';
+      const others = ps.allChess().filter((p) => p.uid !== target.uid && slotFree(m, ps, p, rec))
+        .sort((a, b) => (onBoard(b) - onBoard(a)) || v(b) - v(a) || a.uid - b.uid);
+      const cands = [target, ...others].slice(0, K);
+      if (cands.length > 1) {
+        const chosen = [...ps.board.values()].filter((p) => p && p.kind === 'chess');
+        const plan = new LayoutPlan();
+        for (const [k, p] of ps.board) if (p && p.kind === 'chess') { plan.set(p.uid, k); plan.dirs.set(p.uid, pieceDir(p)); }
+        const cap = boss ? faRehearsalTicks(m) : rehearsalCap(m.wave?.timeLimit);
+        const hadOracle = m._oracle;
+        if (boss && seed === 'live') m._oracle = { ...(hadOracle || {}), liveSeed: true }; else if (boss) m._oracle = undefined;
+        let best = 0, bv = null;
+        try {
+          cands.forEach((carrier, i) => {
+            const byUid = new Map(chosen.map((p) => [p.uid, p.uid === carrier.uid ? { ...p, items: [...(p.items || []), item] } : p]));
+            let opts = boss ? bossCandidateOpts(m, ps, byUid, plan) : candidateOpts(m, ps, byUid, plan);
+            if (!opts) return;
+            if (!boss && seed === 'fixed') opts = { ...opts, seed: deriveSeed(0xA11CE, `n:${m.round}:${ps.seat}`) };
+            try {
+              const battle = m.newBattle(opts, { preview: true });
+              for (let t = 0; t < cap && !battle.finished; t++) battle.step(); // loop-cap: the rehearsal tick cap
+              if (!battle.finished) battle.forceEnd('timeout');
+              const r = battle.result(), pp = r && !r.synthetic && r.perPlayer && r.perPlayer[ps.playerId];
+              if (!pp) return;
+              const s = { leaks: (pp.leaked || []).filter((l) => l && l.counted !== false).length, boss: Math.max(0, Number(pp.bossDamage) || 0), kills: pp.killed || 0 };
+              if (!bv || s.leaks < bv.leaks || (s.leaks === bv.leaks && (s.boss > bv.boss || (s.boss === bv.boss && s.kills > bv.kills)))) { bv = s; best = i; }
+            } catch { /* a failed preview is skipped */ }
+          });
+        } finally { m._oracle = hadOracle; }
+        if (stats) {
+          const key = boss ? 'boss' : 'normal', R = (stats.byRound[m.round] ||= { decisions: 0, changed: 0 });
+          stats.decisions++; stats.cands += cands.length; stats.ms += performance.now() - t0; R.decisions++;
+          stats[key] = (stats[key] || 0) + 1; if (best > 0) { stats.changed++; R.changed++; stats[`${key}Changed`] = (stats[`${key}Changed`] || 0) + 1; }
+        }
+        target = cands[best];
+      }
+    } else if (stats) { const R = (stats.byRound[m.round] ||= { decisions: 0, changed: 0 }); R.skipped = (R.skipped || 0) + 1; }
+    if (!tryDo(() => ps.equip(item.uid, target.uid)) && advisorPlan(m, ps)?.items?.equip?.length) {
+      const fallback = itemTarget(m, ps, item, ctx, false);
+      if (fallback && fallback.uid !== target.uid) tryDo(() => ps.equip(item.uid, fallback.uid));
+    }
+  }
+}
+
+/** Bounty rounds (tools/rl diagnostics): the seat's active bounties' spawns in this round's fight ([] when none). */
+export function bountySpawnsForTraining(m, ps) {
+  const boss = !m.wave && bossWaveOf(m, ps), wave = m.wave || (boss && boss.wave);
+  if (!wave || !Array.isArray(ps.bounties) || !ps.bounties.length) return [];
+  return bountySpawns(ps.gd || m.gd, m.round, wave, ps.bounties, ps.playerId, { solo: !!m.isSolo, side: boss ? boss.side : null });
+}
+
+/**
+ * Teacher / diagnostics only (tools/rl track 2, stacking oracle): K candidates — the current layout, legacy's generator
+ * variants, then random legal perturbations (move / swap / turn) — each rehearsed once with the live fight's seed.
+ * Normal rounds: among the candidates leaking no more than the current one, the most layers gained in the battle (ties:
+ * kills); boss rounds: legacy's ranking (leaks, leader damage, kills). Applies the winner. { n, idx, layers0, layers }.
+ */
+export function stackOracleForTraining(m, ps, { K = 16, perturb = true, seed = 'live', score = 'layers' } = {}) {
+  const boss = !m.wave && bossWaveOf(m, ps);
+  if (!m.wave && !boss) return null;
+  const C = layoutCandidatesForPicker(m, ps, perturb ? 9 : K); if (!C) return null;
+  const { chosen } = C, byUid = new Map(chosen.map((p) => [p.uid, p])), map = ps.deployMap(), rng = oracleRng2(m, ps);
+  const seen = new Set(C.cands.map(oracle2Sig)), cands = C.cands.slice();
+  for (let guard = 0; perturb && cands.length < K && guard < K * 30; guard++) {
+    const q = oracle2Perturb(m, ps, byUid, cands[Math.floor(rng() * cands.length)], rng, map), s = oracle2Sig(q);
+    if (!seen.has(s)) { seen.add(s); cands.push(q); }
+  }
+  const cap = boss ? faRehearsalTicks(m) : rehearsalCap(m.wave?.timeLimit), hadOracle = m._oracle;
+  if (boss) m._oracle = seed === 'live' ? { ...(hadOracle || {}), liveSeed: true } : undefined;
+  let sc;
+  try {
+    sc = cands.map((plan) => {
+      let opts = boss ? bossCandidateOpts(m, ps, byUid, plan) : candidateOpts(m, ps, byUid, plan);
+      if (!opts) return null;
+      if (!boss && seed === 'fixed') opts = { ...opts, seed: deriveSeed(0xA11CE, `n:${m.round}:${ps.seat}`) };
+      try {
+        const battle = m.newBattle(opts, { preview: true });
+        for (let t = 0; t < cap && !battle.finished; t++) battle.step(); // loop-cap: the rehearsal tick cap
+        if (!battle.finished) battle.forceEnd('timeout');
+        const r = battle.result(), pp = r && !r.synthetic && r.perPlayer && r.perPlayer[ps.playerId];
+        return pp ? { leaks: (pp.leaked || []).filter((l) => l && l.counted !== false).length, boss: Math.max(0, Number(pp.bossDamage) || 0), kills: pp.killed || 0,
+          layers: Object.values(pp.layerGains || {}).reduce((a, b) => a + b, 0) } : null;
+      } catch { return null; }
+    });
+  } finally { m._oracle = hadOracle; }
+  if (!sc[0]) return { n: cands.length, idx: 0, layers0: 0, layers: 0 };
+  let best = 0;
+  for (let j = 1; j < sc.length; j++) {
+    const s = sc[j], b = sc[best]; if (!s) continue;
+    const better = boss || score === 'outcome' ? (s.leaks < b.leaks || (s.leaks === b.leaks && (s.boss > b.boss || (s.boss === b.boss && s.kills > b.kills))))
+      : (s.leaks <= sc[0].leaks && (s.layers > b.layers || (s.layers === b.layers && s.kills > b.kills)));
+    if (better) best = j;
+  }
+  if (best > 0) runSteps(applyPlanSteps(m, ps, chosen, cands[best]));
+  return { n: cands.length, idx: best, layers0: sc[0].layers, layers: sc[best].layers, boss: !!boss };
+}
