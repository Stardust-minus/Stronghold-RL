diff --git a/server/match/seatPlan.js b/server/match/seatPlan.js
new file mode 100644
index 0000000..1737522
--- /dev/null
+++ b/server/match/seatPlan.js
@@ -0,0 +1,115 @@
+// server/match/seatPlan.js — the one-round-trip prep plan of a model-AI seat (the AI model plan: client inference; the RL
+// environment tools/rl/env.mjs simulates the same rules). Gated: only a PlayerState whose `_seatPlan` is set (beginSeatPlan)
+// behaves differently; legacy bots, humans and golden replays never set it, so their rng streams are untouched.
+//   - Refresh table: at the prep start, rolls[L][k] for shop levels L = level .. level + 2 and k < SEAT_PLAN_REFRESHES,
+//     drawn from the seat's own stream deriveSeed(seed, 'aiShop:<playerId>:<round>') and the prep-start pool. The k-th
+//     reroll the seat makes while its shop is at level L (k counted per level, from 0) shows rolls[L][k]; its rerolls
+//     never draw m.rngShop. The device receives the table, never the pool counts (those are hidden from players).
+//   - Offer table: merge reward offers likewise — offers[T][j] for every tier T and j < SEAT_PLAN_OFFERS, drawn after the
+//     refresh table from the same stream and pool (player/acquire.js pushRewardOffer's draw); the j-th rolled offer of tier
+//     T the seat gets shows offers[T][j].
+//   - Its own effects (random coin, same-bond grants, rng picks of 机变 / item effects) draw the seat's meta stream
+//     deriveSeed(seed, 'aiMeta:<playerId>:<round>') instead of m.rngMeta.
+//   - A draw a device cannot reproduce — an effect rolling the shared pool, an offer or a reroll past its table —
+//     is a stop point: counted in `stops`; the plan ends there and the server (in training: the env) carries on.
+//   - Foreign effects: what another player's action does to the seat while its plan is open (a teammate's team tactic
+//     card, an effect of another seat writing through ctx.teammates() / ctx.player()) waits in `foreign` and is applied
+//     when the plan ends (the seat's Ready or the prep end), on the match streams; counted as stops.foreign.
+import { createRng, deriveSeed } from '../sim/rng.js';
+
+export const SEAT_PLAN_REFRESHES = 12, SEAT_PLAN_LEVELS = 3, SEAT_PLAN_OFFERS = 6;
+
+/** The seat's plan for the current round, or null (none, or left over from an earlier round). */
+export function seatPlanOf(ps) {
+  const p = ps && ps._seatPlan;
+  return p && ps.m && p.round === ps.m.round ? p : null;
+}
+
+/** A full shop layout at level `level` from `rng` (economy.js rollShop's draw order: chess slots, then item slots). */
+function rollLayout(ps, level, rng) {
+  const { chess: nChess, item: nItem } = ps.gd.shopSlots(level);
+  const slots = [];
+  for (let i = 0; i < nChess; i++) slots.push(ps._rollChessSlot(rng, level));
+  for (let i = 0; i < nItem; i++) slots.push(ps._rollItemSlot(rng, level));
+  return { slots, layout: { chess: nChess, item: nItem } };
+}
+
+/** A merge reward offer of tier `t` from `rng` (player/acquire.js pushRewardOffer's draw: distinct ids, lower tiers when empty). */
+function rollOffer(ps, t, count, rng) {
+  const list = [], fresh = (id) => !list.includes(id);
+  for (let i = 0; i < count; i++) { // loop-cap: rewardOffer().count
+    let id = null;
+    for (let tt = t; tt >= 1 && !id; tt--) id = ps.pool.roll(rng, { tier: tt, filter: fresh, extra: ps.diyStockEntries() });
+    if (id) list.push(id);
+  }
+  return list;
+}
+
+/** pushRewardOffer for a planning seat: its next planned offer of tier `t` (a copy), or null (no plan / past the table). */
+export function seatPlanOffer(ps, t) {
+  const p = seatPlanOf(ps);
+  if (!p) return null;
+  const rows = p.offers.get(t), k = p.offered.get(t) || 0;
+  if (!rows || k >= rows.length) return null;
+  p.offered.set(t, k + 1);
+  return rows[k].slice();
+}
+
+/** Start the seat's plan for this prep: the refresh and offer tables and its meta stream. */
+export function beginSeatPlan(m, ps) {
+  const shop = createRng(deriveSeed(m.seed, `aiShop:${ps.playerId}:${m.round}`));
+  const L0 = ps.shop.level, maxL = Number.isInteger(ps.gd.maxShopLevel) ? ps.gd.maxShopLevel : L0;
+  const table = new Map();
+  for (let L = L0; L <= Math.min(maxL, L0 + SEAT_PLAN_LEVELS - 1); L++) { // loop-cap: SEAT_PLAN_LEVELS levels × SEAT_PLAN_REFRESHES rolls
+    const rows = [];
+    for (let k = 0; k < SEAT_PLAN_REFRESHES; k++) rows.push(rollLayout(ps, L, shop));
+    table.set(L, rows);
+  }
+  const ro = ps.gd.rewardOffer(), offers = new Map();
+  for (let T = 1; T <= ro.maxTier; T++) { // loop-cap: reward tiers × SEAT_PLAN_OFFERS offers
+    const rows = [];
+    for (let j = 0; j < SEAT_PLAN_OFFERS; j++) rows.push(rollOffer(ps, T, ro.count, shop));
+    offers.set(T, rows);
+  }
+  ps._seatPlan = { round: m.round, table, rerolls: new Map(), offers, offered: new Map(), shop, meta: createRng(deriveSeed(m.seed, `aiMeta:${ps.playerId}:${m.round}`)),
+    stops: { pool: 0, offer: 0, table: 0, foreign: 0 }, foreign: [] };
+  return ps._seatPlan;
+}
+
+/** End the seat's plan (its Ready, or the prep's end): then the foreign effects it held, on the match streams. Returns its stop counts. */
+export function endSeatPlan(ps) {
+  const p = ps && ps._seatPlan;
+  if (ps) ps._seatPlan = null;
+  if (!p) return null;
+  for (const fn of p.foreign.splice(0)) fn(); // loop-cap: effects queued during one prep
+  return p.stops;
+}
+
+/** Hold `fn` (another player's effect on `ps`) while ps's plan is open; false = no plan: run it now. */
+export function deferForeign(ps, fn) {
+  const p = seatPlanOf(ps);
+  if (!p) return false;
+  p.stops.foreign++; p.foreign.push(fn);
+  return true;
+}
+
+/** Total rerolls of the seat's plan so far (every level). */
+export function seatPlanRerolls(ps) {
+  const p = seatPlanOf(ps);
+  let n = 0; if (p) for (const k of p.rerolls.values()) n += k;
+  return n;
+}
+
+/** economy.js rollShop for a planning seat's full reroll: the table's next row at the current level (true = done). */
+export function seatPlanReroll(ps) {
+  const p = seatPlanOf(ps);
+  if (!p) return false;
+  const L = ps.shop.level, rows = p.table.get(L), k = p.rerolls.get(L) || 0;
+  p.rerolls.set(L, k + 1);
+  let roll = rows && k < rows.length ? rows[k] : null;
+  if (!roll) { p.stops.table++; roll = rollLayout(ps, ps.shop.level, p.shop); }
+  ps.shop.slots = roll.slots.map((s) => (s ? { ...s, frozen: ps.shop.frozen } : null));
+  ps.shop.layout = { ...roll.layout };
+  ps.dirty();
+  return true;
+}
